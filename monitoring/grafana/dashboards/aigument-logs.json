{
  "title": "Aigument - Application Logs",
  "uid": "aigument-logs",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "level",
        "type": "custom",
        "label": "Log Level",
        "query": "INFO,ERROR",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "레벨별 로그량",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "aigument-loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "aigument-loki" },
          "expr": "sum by (level) (count_over_time({app=\"aigument\"} | level=~\"${level:pipe}\" [$__interval]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "INFO" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "최근 6시간 ERROR 로그 수",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "aigument-loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "aigument-loki" },
          "expr": "sum(count_over_time({app=\"aigument\"} | level=\"ERROR\" [$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "클래스별 ERROR 발생 Top 10",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
      "datasource": { "type": "loki", "uid": "aigument-loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "aigument-loki" },
          "expr": "topk(10, sum by (class) (count_over_time({app=\"aigument\"} | level=\"ERROR\" | regexp \"\\\\[(?P<class>[A-Za-z0-9_]+)\\\\]\" [$__range])))",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "실시간 로그 (레벨 필터 적용)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "aigument-loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "aigument-loki" },
          "expr": "{app=\"aigument\"} | level=~\"${level:pipe}\"",
          "refId": "A"
        }
      ]
    }
  ]
}
